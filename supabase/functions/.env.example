# ============================================================================
# WALLET · Secrets des Edge Functions
#
# À définir avec :  supabase secrets set --env-file supabase/functions/.env
# NE JAMAIS committer le fichier .env réel (il est ignoré par git).
# ============================================================================

# Clé maîtresse de chiffrement des identifiants d'exchange (AES-256-GCM).
# 32 caractères minimum. Générez-la avec :
#   openssl rand -base64 48
# Si vous la perdez, les clés Kraken/OKX enregistrées deviennent illisibles :
# il faudra les reconnecter. Ce n'est pas grave, mais autant le savoir.
CREDENTIALS_KEY=

# Secret partagé entre le planificateur (GitHub Actions ou pg_cron) et les
# fonctions déclenchées sans session utilisateur.
#   openssl rand -hex 32
CRON_SECRET=

# Origine autorisée pour les requêtes CORS.
# En production, remplacez * par l'URL exacte de votre application, par
# exemple https://corentin-bocquet.github.io
ALLOWED_ORIGIN=*
